<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f0f0f5">

    <!-- Фіксована шапка, яка не скролиться -->
    <androidx.cardview.widget.CardView
        android:id="@+id/headerCard"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:cardElevation="4dp"
        app:cardCornerRadius="0dp"
        app:cardBackgroundColor="#FFFFFF"
        android:layout_alignParentTop="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="16dp">

            <!-- Стрілка "назад" -->
            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_back"/>

            <!-- Заголовок -->
            <TextView
                android:id="@+id/tvPaymentTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Оформлення замовлення"
                android:layout_marginStart="12dp"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:gravity="start" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Основний контент, який скролиться -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerCard"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Контейнер "Ваше замовлення" -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_margin="4dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- Заголовок контейнера "Ваше замовлення" -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ваше замовлення"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:padding="4dp" />

                    <!-- Горизонтальна лінія -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#CCCCCC"
                        android:layout_marginBottom="8dp"/>

                    <!-- RecyclerView для даних замовлення -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerViewOrder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:overScrollMode="never"
                        android:nestedScrollingEnabled="false"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Контейнер "Контактні дані отримувача" -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_margin="4dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- Заголовок контейнера "Контактні дані отримувача" -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Контактні дані отримувача"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:padding="4dp" />

                    <!-- Горизонтальна лінія -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#CCCCCC"
                        android:layout_marginBottom="8dp"/>

                    <!-- Підпис "Ім'я" -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ім'я"
                        android:textSize="14sp"
                        android:paddingTop="4dp" />

                    <!-- Поле для введення імені -->
                    <EditText
                        android:id="@+id/etRecipientName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ім'я"
                        android:background="@drawable/edit_text_no_shadow"
                        android:padding="8dp"
                        android:textSize="14sp" />

                    <!-- Підпис "Пошта" -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Пошта"
                        android:textSize="14sp"
                        android:paddingTop="8dp" />

                    <!-- Поле для введення пошти -->
                    <EditText
                        android:id="@+id/etRecipientEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Пошта"
                        android:background="@drawable/edit_text_no_shadow"
                        android:padding="8dp"
                        android:textSize="14sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Контейнер "Доставка" -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_margin="4dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- Заголовок контейнера "Доставка" -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Доставка"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:padding="4dp" />

                    <!-- Горизонтальна лінія -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#CCCCCC"
                        android:layout_marginBottom="8dp"/>

                    <!-- Рядок з логотипом та текстом "Нова Пошта" -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="8dp">

                        <!-- Логотип Нової Пошти -->
                        <ImageView
                            android:id="@+id/ivNovaPoshtaLogo"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_nova_poshta_logo"
                            android:contentDescription="Логотип Нової Пошти"
                            android:layout_marginEnd="8dp"/>

                        <!-- Текст "Нова Пошта" -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Нова Пошта"
                            android:textSize="16sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Підпис "Місто" -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Місто"
                        android:textSize="14sp"
                        android:paddingTop="4dp" />

                    <!-- Поле для введення міста -->
                    <EditText
                        android:id="@+id/etCity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Місто"
                        android:background="@drawable/edit_text_no_shadow"
                        android:padding="8dp"
                        android:textSize="14sp" />

                    <!-- Підпис "Відділення" -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Відділення"
                        android:textSize="14sp"
                        android:paddingTop="8dp" />

                    <!-- Поле для введення відділення -->
                    <EditText
                        android:id="@+id/etDepartment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Відділення"
                        android:background="@drawable/edit_text_no_shadow"
                        android:padding="8dp"
                        android:textSize="14sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Контейнер "Оплата" -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_margin="4dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- Заголовок контейнера "Оплата" -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Оплата"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:padding="4dp" />

                    <!-- Горизонтальна лінія -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#CCCCCC"
                        android:layout_marginBottom="8dp"/>

                    <!-- Текст "Як бажаєте оплатити:" -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Як бажаєте оплатити:"
                        android:textSize="14sp"
                        android:paddingBottom="8dp" />

                    <!-- RadioGroup з варіантами оплати -->
                    <RadioGroup
                        android:id="@+id/rgPaymentMethod"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbCardPayment"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Оплата картою" />

                        <RadioButton
                            android:id="@+id/rbCashOnDelivery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Оплата при отриманні"
                            android:layout_marginStart="16dp"/>
                    </RadioGroup>

                    <!-- Контейнер для полів оплати картою -->
                    <LinearLayout
                        android:id="@+id/llCardPaymentFields"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp"
                        android:visibility="gone">

                        <!-- Підпис "Номер карти" -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Номер карти"
                            android:textSize="14sp"
                            android:paddingTop="4dp" />

                        <!-- Поле для введення номера карти -->
                        <EditText
                            android:id="@+id/etCardNumber"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Номер карти"
                            android:background="@drawable/edit_text_no_shadow"
                            android:padding="8dp"
                            android:textSize="14sp" />

                        <!-- Контейнер для Термін дії та CVV -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">

                            <!-- Контейнер для Термін дії -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <!-- Підпис "Термін дії" -->
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Термін дії"
                                    android:textSize="14sp"
                                    android:paddingTop="4dp" />

                                <!-- Поле для введення терміну дії -->
                                <EditText
                                    android:id="@+id/etExpiry"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="MM/YY"
                                    android:background="@drawable/edit_text_no_shadow"
                                    android:padding="8dp"
                                    android:textSize="14sp" />
                            </LinearLayout>

                            <!-- Контейнер для CVV -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="8dp">

                                <!-- Підпис "CVV" -->
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="CVV"
                                    android:textSize="14sp"
                                    android:paddingTop="4dp" />

                                <!-- Поле для введення CVV -->
                                <EditText
                                    android:id="@+id/etCVV"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="CVV"
                                    android:background="@drawable/edit_text_no_shadow"
                                    android:padding="8dp"
                                    android:textSize="14sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Нижній контейнер із загальною вартістю та кнопкою -->
            <LinearLayout
                android:id="@+id/bottomContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvTotalCost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Вартість замовлення: 0 грн"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btnPay"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="Завершити оформлення"
                    android:textColor="@android:color/white"
                    android:background="@drawable/button_red"
                    android:backgroundTint="@null"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>

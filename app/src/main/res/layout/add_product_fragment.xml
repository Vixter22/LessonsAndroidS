<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f0f0f5">

    <!-- Шапка з кнопкою "Назад" та заголовком -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:cardElevation="4dp"
        app:cardCornerRadius="0dp"
        app:cardBackgroundColor="#FFFFFF">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/ivBackAddProduct"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:src="@drawable/ic_back"
                android:contentDescription="Назад" />

            <TextView
                android:id="@+id/tvTitleAddProduct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/ivBackAddProduct"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:text="Додати товар"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#000000" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- Контейнер з формою додавання товару -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/etProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Назва товару" />

            <EditText
                android:id="@+id/etProductDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Опис товару"
                android:layout_marginTop="8dp" />

            <EditText
                android:id="@+id/etProductPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ціна"
                android:inputType="numberDecimal"
                android:layout_marginTop="8dp" />

            <EditText
                android:id="@+id/etProductStock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Кількість на складі"
                android:inputType="number"
                android:layout_marginTop="8dp" />

            <!-- Image selection: при натисканні відкривається галерея -->
            <ImageView
                android:id="@+id/ivProductImage"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:src="@drawable/ic_addproduct"
                android:contentDescription="Вибрати зображення"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:layout_marginTop="16dp" />

            <!-- Кнопка для додавання товару -->
            <Button
                android:id="@+id/btnAddProduct"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Додати товар"
                android:layout_marginTop="16dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

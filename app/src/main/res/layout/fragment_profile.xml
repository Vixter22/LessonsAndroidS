<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f0f0f5">

    <!-- Фіксований заголовок -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:cardElevation="4dp"
        app:cardCornerRadius="0dp"
        app:cardBackgroundColor="#FFFFFF">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center_vertical">

            <!-- Заголовок "Профіль" -->
            <TextView
                android:id="@+id/tvProfileTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Профіль"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true" />

            <!-- Іконка виходу -->
            <ImageView
                android:id="@+id/iv_exit"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_exit"
                android:contentDescription="Вийти"
                android:padding="4dp" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- Контейнер для контенту профілю -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ScrollView для прокручуваного вмісту -->
        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/container_save_profile"
            android:layout_marginTop="8dp"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="3dp"
                android:layout_marginBottom="150dp">

                <!-- Контейнер для фото профілю з кнопкою "Змінити фото" -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                        <!-- Аватарка -->
                        <ImageView
                            android:id="@+id/img_avatar"
                            android:layout_width="125dp"
                            android:layout_height="125dp"
                            android:src="@drawable/ic_avatar_placeholder"
                            android:scaleType="centerCrop"
                            android:clipToOutline="true"
                            android:background="@drawable/circle" />

                        <!-- Текст та кнопка "Змінити фото" -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="30dp"
                            android:gravity="center_vertical">

                            <!-- Текст "Фото профіля" -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Фото профіля"
                                android:layout_marginStart="10dp"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <!-- Кнопка "Змінити фото" -->
                            <Button
                                android:id="@+id/btn_edit_avatar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@android:color/white"
                                android:background="@drawable/button_red"
                                android:layout_marginStart="2dp"
                                android:text="Змінити фото"
                                android:layout_marginTop="8dp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Контейнер "Керування замовленнями" -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <!-- Заголовок контейнера -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Керування замовленнями"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:padding="4dp" />

                        <!-- Горизонтальна лінія -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#CCCCCC" />

                        <!-- Рядок "Історія замовлень" -->
                        <RelativeLayout
                            android:id="@+id/rl_order_management"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp">

                            <!-- Іконка історії -->
                            <ImageView
                                android:id="@+id/iv_order_history_icon"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_alignParentStart="true"
                                android:src="@drawable/ic_history"
                                android:contentDescription="Історія замовлень"
                                android:padding="2dp" />

                            <!-- Текст "Історія замовлень" -->
                            <TextView
                                android:id="@+id/tv_my_orders"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Історія замовлень"
                                android:textSize="18sp"
                                android:layout_toEndOf="@id/iv_order_history_icon"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="10dp" />

                            <!-- Іконка стрілки -->
                            <ImageView
                                android:id="@+id/iv_order_arrow"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_alignParentEnd="true"
                                android:src="@drawable/ic_arrow"
                                android:contentDescription="Перейти до історії замовлень"
                                android:padding="4dp" />
                        </RelativeLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Контейнер "Персональні дані" -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <!-- Заголовок контейнера -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Персональні дані"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:padding="4dp" />

                        <!-- Горизонтальна лінія -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#CCCCCC" />

                        <!-- Поле для Імені -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ім'я"
                            android:paddingTop="8dp" />
                        <EditText
                            android:id="@+id/editTextName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Ім'я"
                            android:background="@drawable/edit_text_no_shadow"
                            android:padding="8dp" />

                        <!-- Поле для Дати народження -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Дата народження"
                            android:paddingTop="8dp" />
                        <EditText
                            android:id="@+id/editTextBirthDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Дата народження (дд-мм-рррр)"
                            android:inputType="none"
                            android:background="@drawable/edit_text_no_shadow"
                            android:padding="8dp"
                            android:focusable="false"
                            android:clickable="true" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Контейнер "Контактні дані" -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <!-- Заголовок контейнера -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Контактні дані"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:padding="4dp" />

                        <!-- Горизонтальна лінія -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#CCCCCC" />

                        <!-- Поле для Email -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Email"
                            android:paddingTop="8dp" />
                        <EditText
                            android:id="@+id/editTextEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Email"
                            android:inputType="textEmailAddress"
                            android:background="@drawable/edit_text_no_shadow"
                            android:padding="8dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Контейнер "Про себе" -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <!-- Заголовок контейнера -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Про себе"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:padding="4dp" />

                        <!-- Поле для "Про себе" -->
                        <EditText
                            android:id="@+id/editTextAbout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Про себе"
                            android:inputType="textMultiLine"
                            android:minLines="3"
                            android:maxLines="6"
                            android:gravity="top"
                            android:background="@drawable/edit_text_no_shadow"
                            android:padding="8dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Кнопка "Видалити акаунт" із оновленим стилем -->
                <Button
                    android:id="@+id/btn_delete_account"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Видалити акаунт"
                    android:textColor="#D32F2F"
                    android:background="@drawable/button_outline_red"
                    android:layout_margin="2dp"
                    android:layout_gravity="center_horizontal" />
            </LinearLayout>
        </ScrollView>

        <!-- Контейнер для кнопки "Зберегти профіль" з білим фоном -->
        <LinearLayout
            android:id="@+id/container_save_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="#FFFFFF"
            android:padding="10dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_save_profile"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="Зберегти профіль"
                android:textColor="@android:color/white"
                android:background="@drawable/button_red" />
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>

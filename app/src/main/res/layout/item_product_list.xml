<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Рядок товару з вертикальними розділювачами -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <!-- Колонка ID -->
        <TextView
            android:id="@+id/tvProductId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.5"
            android:text="1"
            android:textSize="14sp"
            android:gravity="center" />

        <!-- Вертикальний розділювач -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#CCCCCC"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="4dp" />

        <!-- Колонка Назва (збільшена) -->
        <TextView
            android:id="@+id/tvProductName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_weight="2.5"
            android:text="Назва товару"
            android:textSize="14sp"
            android:gravity="center" />

        <!-- Вертикальний розділювач -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#CCCCCC"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <!-- Колонка Ціна -->
        <TextView
            android:id="@+id/tvProductPrice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.5"
            android:text="Ціна"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="10dp" />

        <!-- Вертикальний розділювач -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#CCCCCC"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <!-- Колонка Дія: іконка видалення -->
        <ImageView
            android:id="@+id/ivDelete"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_delete"
            android:contentDescription="Видалити"
            android:layout_gravity="center"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"/>
    </LinearLayout>

    <!-- Горизонтальна розділююча лінія між рядками -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CCCCCC" />
</LinearLayout>

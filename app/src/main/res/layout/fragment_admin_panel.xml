<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f0f0f5">

    <!-- Заголовок (header) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:cardElevation="4dp"
        app:cardCornerRadius="0dp"
        app:cardBackgroundColor="#FFFFFF">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center_vertical">

            <!-- Заголовок "Адмін Панель" -->
            <TextView
                android:id="@+id/tvAdminTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Адмін Панель"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true" />

            <!-- Іконка виходу -->
            <ImageView
                android:id="@+id/iv_exit"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_exit"
                android:contentDescription="Вийти"
                android:padding="4dp" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- Контейнер для основного контенту -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="4dp">

        <!-- Контейнер "Список товарів" -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardProductList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="2dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- Заголовок контейнера -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Товари"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:padding="4dp" />

                <!-- Горизонтальна лінія -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#CCCCCC" />

                <!-- Рядок "Переглянути список товарів" -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <!-- Іконка товару -->
                    <ImageView
                        android:id="@+id/iv_product_icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentStart="true"
                        android:src="@drawable/ic_product"
                        android:contentDescription="Список товарів"
                        android:padding="2dp" />

                    <!-- Текст "Переглянути список товарів" -->
                    <TextView
                        android:id="@+id/tv_product_list"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Перейти до списку товарів"
                        android:textSize="18sp"
                        android:layout_toEndOf="@id/iv_product_icon"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="10dp" />

                    <!-- Іконка стрілки -->
                    <ImageView
                        android:id="@+id/iv_product_arrow"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentEnd="true"
                        android:src="@drawable/ic_arrow"
                        android:contentDescription="Перейти до списку товарів"
                        android:padding="4dp" />
                </RelativeLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Контейнер "Список замовлень" -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardOrderList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- Заголовок контейнера -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Замовлення"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:padding="4dp" />

                <!-- Горизонтальна лінія -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#CCCCCC" />

                <!-- Рядок "Переглянути список замовлень" -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <!-- Іконка замовлення -->
                    <ImageView
                        android:id="@+id/iv_order_icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentStart="true"
                        android:src="@drawable/ic_order"
                        android:contentDescription="Список замовлень"
                        android:padding="2dp" />

                    <!-- Текст "Переглянути список замовлень" -->
                    <TextView
                        android:id="@+id/tv_order_list"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Перейти до списку замовлень"
                        android:textSize="18sp"
                        android:layout_toEndOf="@id/iv_order_icon"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="10dp" />

                    <!-- Іконка стрілки -->
                    <ImageView
                        android:id="@+id/iv_order_arrow"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentEnd="true"
                        android:src="@drawable/ic_arrow"
                        android:contentDescription="Перейти до списку замовлень"
                        android:padding="4dp" />
                </RelativeLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</LinearLayout>

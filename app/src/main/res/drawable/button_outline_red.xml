<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- При натисканні: прозорий фон з темнішою червоною обводкою -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <stroke android:width="2dp" android:color="#B71C1C"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <!-- Звичайний стан: прозорий фон з основною червоною обводкою -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <stroke android:width="2dp" android:color="#D32F2F"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
</selector>
